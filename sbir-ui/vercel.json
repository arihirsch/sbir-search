{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "buildCommand": "yarn build",
    "devCommand": "yarn dev",
    "framework": "vite",
    "outputDirectory": "dist"
} 